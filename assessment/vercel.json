{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/prepare-deployment.mjs && pnpm build",
  "outputDirectory": ".next",
  "env": {
    "APP_ORIGIN": "https://belhaveen.vercel.app"
  },
  "crons": [
    {
      "path": "/api/admissions/maintenance",
      "schedule": "0 8 * * *"
    }
  ]
}
